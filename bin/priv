# A script to mount/unmount a private encrypted directory.
# Checks first whether the mount point is already mounted.
# Mount -- when 'on' is in the command line.
# Unmount -- when 'off' is in the command line.

# Assume the encrypted and decrypted directories have been set,
#   or set them here below.
# PRIV_ENCRYPTED=/home/me/dir/encrypted
# PRIV_DECRYPTED=/home/me/dir/decrypted

if [[ $@ == *on* ]] && ! grep -q "${PRIV_DECRYPTED} " /proc/mounts
then
	mkdir -p $PRIV_DECRYPTED
	gocryptfs ${PRIV_ENCRYPTED} ${PRIV_DECRYPTED}
	exit 0
elif [[ $@ == *off* ]] && grep -q $PRIV_DECRYPTED /proc/mounts
then
	umount $PRIV_DECRYPTED
	rmdir $PRIV_DECRYPTED
	exit 0
fi
